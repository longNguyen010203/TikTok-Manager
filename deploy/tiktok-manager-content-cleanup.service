[Unit]
Description=TikTok Manager reusable content cleanup
After=tiktok-manager-backend.service

[Service]
Type=oneshot
WorkingDirectory=@PROJECT_ROOT@/backend
ExecStart=@PROJECT_ROOT@/backend/.venv/bin/python -m app.content_cleanup
Environment=TIKTOK_MANAGER_RUNTIME_MODE=production
NoNewPrivileges=true
