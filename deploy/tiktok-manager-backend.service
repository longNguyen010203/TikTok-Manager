[Unit]
Description=TikTok Manager local backend

[Service]
Type=simple
WorkingDirectory=@PROJECT_ROOT@/backend
ExecStart=@PROJECT_ROOT@/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Environment=TIKTOK_MANAGER_RUNTIME_MODE=production
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=default.target
